# Copy to backend/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API cross-origin.
# (Same-origin requests behind a proxy that preserves Host are always allowed.)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database -----------------------------------------------------------------
# Leave empty in dev to use an embedded Postgres (PGlite, stored in PGLITE_DIR).
# Set for staging/production, e.g. postgres://user:pass@host:5432/higgsfield
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DIR=./.data/pglite

# --- Auth ---------------------------------------------------------------------
# dev   = built-in seeded accounts (refuses to start in production)
# clerk = verify Clerk session JWTs (set CLERK_SECRET_KEY, or CLERK_JWT_KEY for networkless verification)
AUTH_PROVIDER=dev
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# --- Integrations (optional: can also be set per-organisation in Settings -> API keys) ---
# Without an Anthropic key the app returns clearly-labelled SIMULATED responses.
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
# Higgsfield generation API address (Studio). Easier to set in the app: Settings -> Higgsfield.
# The key (id:secret) goes in Settings -> API keys. See docs/architecture.md for the contract used.
HIGGSFIELD_API_BASE=

# --- Security -----------------------------------------------------------------
# Encrypts API keys stored in the database (AES-256-GCM). REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# --- Misc ---------------------------------------------------------------------
SEED_DEMO_DATA=true
QUEUE_CONCURRENCY=2
LOG_LEVEL=debug

# Parallel Studio generations (mostly idle polling) and how often to poll Higgsfield (ms)
GENERATION_CONCURRENCY=8
STUDIO_POLL_MS=4000
