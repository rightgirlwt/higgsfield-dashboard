const express = require('express');
const cors = require('cors');
const http = require('http');
const dotenv = require('dotenv');
const { Server } = require('socket.io');

dotenv.config();

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: {
    origin: '*',
  },
});

const PORT = process.env.PORT || 4000;

app.use(cors());
app.use(express.json());

const spendTrend = [
  { day: 'Mon', spend: 420 },
  { day: 'Tue', spend: 540 },
  { day: 'Wed', spend: 470 },
  { day: 'Thu', spend: 620 },
  { day: 'Fri', spend: 710 },
  { day: 'Sat', spend: 680 },
  { day: 'Sun', spend: 760 },
];

const promptRuns = [
  { name: 'Customer QA Review', model: 'Claude 3.5 Sonnet', status: 'Completed', cost: 242.1 },
  { name: 'Scene Captioning', model: 'Claude 3 Opus', status: 'Running', cost: 186.4 },
  { name: 'Workflow Summary', model: 'Claude 3.5 Haiku', status: 'Completed', cost: 94.2 },
  { name: 'Incident Triage', model: 'Claude 3.5 Sonnet', status: 'Queued', cost: 154.8 },
];

const workflows = [
  { title: 'Higgsfield Input', status: 'Healthy', type: 'source' },
  { title: 'Prompt Router', status: 'Healthy', type: 'logic' },
  { title: 'Vision Analysis', status: 'Running', type: 'ai' },
  { title: 'Upload Archive', status: 'Healthy', type: 'action' },
  { title: 'Notify Team', status: 'Queued', type: 'action' },
];

const mediaItems = [
  { type: 'video', title: 'Warehouse scan 14:20', date: 'Today · 2:20 PM', tags: ['motion', 'inventory'] },
  { type: 'photo', title: 'Dock camera frame', date: 'Today · 1:42 PM', tags: ['dock', 'alerts'] },
  { type: 'video', title: 'Operator walkthrough', date: 'Yesterday · 9:14 AM', tags: ['ops', 'review'] },
  { type: 'photo', title: 'Inspection snapshot', date: 'Yesterday · 7:03 AM', tags: ['quality', 'review'] },
];

const dashboardSummary = {
  monthlySpend: 8420,
  promptRuns: 24600,
  activeWorkflows: 32,
  mediaAssets: 7210,
};

const monitoring = {
  apiHealth: 99.8,
  latencyMs: 263,
  queueSize: 12,
  lastUpdated: new Date().toISOString(),
};

app.get('/api/health', (_req, res) => {
  res.json({ status: 'ok', service: 'higgsfield-dashboard-backend' });
});

app.get('/api/dashboard/summary', (_req, res) => {
  res.json(dashboardSummary);
});

app.get('/api/dashboard/spend', (_req, res) => {
  res.json(spendTrend);
});

app.get('/api/prompts/runs', (_req, res) => {
  res.json(promptRuns);
});

app.get('/api/workflows', (_req, res) => {
  res.json(workflows);
});

app.get('/api/media', (_req, res) => {
  res.json(mediaItems);
});

app.get('/api/monitoring', (_req, res) => {
  res.json(monitoring);
});

app.post('/api/prompts/run', (req, res) => {
  const { name, model, prompt } = req.body || {};

  const newRun = {
    name: name || 'New Prompt Run',
    model: model || 'Claude 3.5 Sonnet',
    status: 'Queued',
    cost: 0,
    prompt: prompt || '',
  };

  promptRuns.unshift(newRun);
  io.emit('prompt:updated', newRun);

  res.status(201).json(newRun);
});

app.post('/api/workflows/run', (req, res) => {
  const { title } = req.body || {};
  const workflow = {
    title: title || 'New Workflow',
    status: 'Running',
    type: 'ai',
  };

  workflows.unshift(workflow);
  io.emit('workflow:updated', workflow);

  res.status(201).json(workflow);
});

io.on('connection', (socket) => {
  console.log('socket connected', socket.id);

  socket.emit('monitoring:initial', monitoring);

  socket.on('disconnect', () => {
    console.log('socket disconnected', socket.id);
  });
});

let tick = 0;
setInterval(() => {
  tick += 1;
  monitoring.lastUpdated = new Date().toISOString();
  monitoring.queueSize = 12 + (tick % 5);
  monitoring.latencyMs = 240 + (tick % 30);
  io.emit('monitoring:update', monitoring);
}, 15000);

server.listen(PORT, () => {
  console.log(`Higgsfield dashboard backend listening on http://localhost:${PORT}`);
});
