# Production values for docker compose (copy to deploy/.env.production - it is git-ignored).
POSTGRES_USER=higgsfield
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=higgsfield

CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# openssl rand -hex 32  - back this up: losing it makes stored API keys unrecoverable.
SECRETS_ENCRYPTION_KEY=

# Public origin(s) of the site, comma separated.
CLIENT_ORIGIN=https://studio.example.com

# Optional global fallbacks (orgs can also store their own keys in Settings).
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=
