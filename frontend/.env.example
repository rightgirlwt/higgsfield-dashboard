# Frontend build/dev variables (Vite). Only VITE_* values reach the browser - never put secrets here.

# Dev: leave empty (the Vite dev server proxies /api and /socket.io to the backend).
# Split-host deploys: the backend's public URL, e.g. https://api.example.com
VITE_API_BASE_URL=

# Required only when the backend runs with AUTH_PROVIDER=clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Dev only: where the Vite proxy forwards API traffic.
# VITE_API_PROXY=http://localhost:4000
